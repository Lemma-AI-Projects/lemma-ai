# Supabase project URL (same as backend SUPABASE_URL)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable (anon) key — designed to be public, safe in the browser
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Backend API base URL
VITE_API_BASE_URL=http://localhost:8000

# NOTE: server-side secrets (AI platform keys, database URLs) NEVER go in this
# file — they belong in backend/.env, which is gitignored there.
