# Supabase project URL (same as backend SUPABASE_URL)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable (anon) key — designed to be public, safe in the browser
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Backend API base URL
VITE_API_BASE_URL=http://localhost:8000

# Desmos API key (https://www.desmos.com/my-api) — used by the AI graph card.
# Designed to be public (it rides in the calculator.js script URL).
VITE_DESMOS_API_KEY=

# PayPal client-side (publishable) client id — safe to expose in the browser.
# Must come from the same PayPal app as the backend's PAYPAL_MODE: use that app's
# sandbox id here while the backend runs in sandbox, and its live id after the
# switch. The button stays disabled when this is empty.
VITE_PAYPAL_CLIENT_ID=
VITE_PAYPAL_MODE=sandbox

# NOTE: server-side secrets (AI platform keys, database URLs, the PayPal secret
# and webhook id) NEVER go in this file — they belong in backend/.env, which is
# gitignored there.
