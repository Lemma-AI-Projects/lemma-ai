# Supabase project API URL (no trailing slash)
SUPABASE_URL=https://your-project-ref.supabase.co

# Audience claim on Supabase user access tokens (leave as-is)
SUPABASE_JWT_AUDIENCE=authenticated

# Only needed for legacy Supabase projects that still issue HS256 user tokens.
# Leave empty for projects using asymmetric JWT signing keys / JWKS.
SUPABASE_JWT_SECRET=

# Async Postgres connection string for SQLAlchemy (asyncpg driver).
# Copy the connection string from the Supabase dashboard:
#   Connect -> Session pooler
# then change the scheme to "postgresql+asyncpg://" and fill in your password.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/postgres

# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173

# --- AI providers ---

# AiHubMix API key (primary platform, OpenAI-compatible /v1 endpoint)
AIHUBMIX_API_KEY=sk-your-aihubmix-key

# OpenRouter API key (backup platform)
OPENROUTER_API_KEY=sk-or-your-openrouter-key

# AiHubMix OpenAI-compatible endpoint (leave as-is)
AIHUBMIX_OPENAI_BASE_URL=https://aihubmix.com/v1

# AiHubMix Gemini-native endpoint for the video track (leave as-is; the
# google-genai SDK appends /v1beta itself)
AIHUBMIX_GEMINI_BASE_URL=https://aihubmix.com/gemini

# Default HTTP timeout for AI calls, in seconds
AI_DEFAULT_TIMEOUT_SECONDS=30

# Video execution engine: native (google-genai direct, default) | pydantic_ai
# (GoogleModel via the framework — allowed since probes 3-6 passed 2026-06-10)
AI_VIDEO_ENGINE=native

# Routing table: use_case -> ordered candidates (single-line JSON; lower
# priority wins, multiple entries form a fallback chain). Schema and startup
# validation live in ai/config.py. Omit to use the built-in default (text +
# course use cases: AiHubMix primary + OpenRouter backup; video: AiHubMix
# /gemini). Course generation reuses the text channel.
# AI_ROUTES_JSON={"text_chat": [{"platform": "aihubmix", "adapter": "openai_compatible", "model": "gemini-2.5-flash", "priority": 0, "timeout_s": 30}, {"platform": "openrouter", "adapter": "openrouter", "model": "google/gemini-2.5-flash", "priority": 1, "timeout_s": 30}], "course_plan_intro": [{"platform": "aihubmix", "adapter": "openai_compatible", "model": "gemini-2.5-flash", "priority": 0, "timeout_s": 30}, {"platform": "openrouter", "adapter": "openrouter", "model": "google/gemini-2.5-flash", "priority": 1, "timeout_s": 30}], "video_qa": [{"platform": "aihubmix", "adapter": "gemini_video", "model": "gemini-2.5-flash", "priority": 0, "timeout_s": 90}], "video_summary": [{"platform": "aihubmix", "adapter": "gemini_video", "model": "gemini-2.5-flash", "priority": 0, "timeout_s": 90}], "video_locate": [{"platform": "aihubmix", "adapter": "gemini_video", "model": "gemini-2.5-pro", "priority": 0, "timeout_s": 90}], "course_intake": [{"platform": "aihubmix", "adapter": "openai_compatible", "model": "gemini-2.5-flash", "priority": 0, "timeout_s": 60}, {"platform": "openrouter", "adapter": "openrouter", "model": "google/gemini-2.5-flash", "priority": 1, "timeout_s": 60}], "course_outline": [{"platform": "aihubmix", "adapter": "openai_compatible", "model": "gemini-2.5-flash", "priority": 0, "timeout_s": 60}, {"platform": "openrouter", "adapter": "openrouter", "model": "google/gemini-2.5-flash", "priority": 1, "timeout_s": 60}], "chapter_query": [{"platform": "aihubmix", "adapter": "openai_compatible", "model": "gemini-2.5-flash", "priority": 0, "timeout_s": 60}, {"platform": "openrouter", "adapter": "openrouter", "model": "google/gemini-2.5-flash", "priority": 1, "timeout_s": 60}], "video_select": [{"platform": "aihubmix", "adapter": "openai_compatible", "model": "gemini-2.5-flash", "priority": 0, "timeout_s": 60}, {"platform": "openrouter", "adapter": "openrouter", "model": "google/gemini-2.5-flash", "priority": 1, "timeout_s": 60}], "topic_search": [{"platform": "aihubmix", "adapter": "openai_compatible", "model": "gemini-2.5-flash", "priority": 0, "timeout_s": 60}, {"platform": "openrouter", "adapter": "openrouter", "model": "google/gemini-2.5-flash", "priority": 1, "timeout_s": 60}], "course_compose": [{"platform": "aihubmix", "adapter": "openai_compatible", "model": "gemini-2.5-flash", "priority": 0, "timeout_s": 90}, {"platform": "openrouter", "adapter": "openrouter", "model": "google/gemini-2.5-flash", "priority": 1, "timeout_s": 90}]}

# --- Video search ---

# Default video search uses self-built, FREE providers (yt-dlp for YouTube,
# Bilibili's official Web search) — no key or token. The Apify settings below
# are ONLY needed if you opt into Apify as a paid fallback in SEARCH_ROUTES_JSON.

# Apify API token (https://console.apify.com/settings/integrations). ONLY needed
# if you add an apify_* route to SEARCH_ROUTES_JSON; leave empty otherwise.
APIFY_API_TOKEN=

# Routing table: platform -> ordered provider candidates (single-line JSON;
# lower priority wins, multiple entries form a fallback chain). Schema + startup
# validation live in ai/search/config.py; per-provider knobs go in `extra`.
# Omit to use the built-in default (self-built-only, shown here):
# SEARCH_ROUTES_JSON={"youtube": [{"provider": "ytdlp_youtube", "max_items": 20, "timeout_s": 60, "priority": 0, "extra": {"full_extract": false}}], "bilibili": [{"provider": "bili_search", "max_items": 20, "timeout_s": 30, "priority": 0, "extra": {"wbi": false}}]}
#
# Opt-in Apify paid fallback (priority 1, needs APIFY_API_TOKEN). actor_id and
# max_total_charge_usd are MANDATORY for apify_* routes (cost hard cap):
# SEARCH_ROUTES_JSON={"youtube": [{"provider": "ytdlp_youtube", "max_items": 20, "timeout_s": 60, "priority": 0, "extra": {"full_extract": false}}, {"provider": "apify_youtube", "actor_id": "h7sDV53CddomktSi5", "max_items": 20, "max_total_charge_usd": 0.3, "timeout_s": 120, "priority": 1}], "bilibili": [{"provider": "bili_search", "max_items": 20, "timeout_s": 30, "priority": 0, "extra": {"wbi": false}}, {"provider": "apify_bilibili", "actor_id": "hQpkxbmfApbahVZ2B", "max_items": 20, "max_total_charge_usd": 0.3, "timeout_s": 120, "priority": 1}]}

# --- Background tasks (Celery) ---

# Redis broker/result backend for Celery (video ingest pipeline)
REDIS_URL=redis://localhost:6379/0

# Optional: Netscape-format cookie file for yt-dlp. This only affects the
# yt-dlp path/fallback; primary anonymous B站 chapter downloads use BBDown TV API.
# YTDLP_COOKIE_FILE=/path/to/bilibili-cookies.txt

# yt-dlp socket timeout, in seconds.
YTDLP_SOCKET_TIMEOUT_SECONDS=30

# --- Worker video download backends ---
# URL -> local mp4 routing inside Celery workers. YouTube remains yt-dlp.
# Bilibili defaults to BBDown TV API, then yt-dlp with Bilibili headers as a
# 480P fallback. Unknown/direct http(s) URLs keep the old yt-dlp behavior.
VIDEO_DOWNLOAD_ROUTES_JSON={"youtube":["ytdlp"],"bilibili":["bbdown","ytdlp-fallback"],"default":["ytdlp"]}

# Overall per-backend subprocess/download timeout. Long lectures need headroom.
VIDEO_DOWNLOAD_TIMEOUT_SECONDS=1800

# ffmpeg binary used by both yt-dlp and BBDown for merging.
FFMPEG_PATH=ffmpeg

# BBDown is not a Python dependency. Install the linux-x64 release in the worker
# image/build phase and point this at the executable, e.g.
#   https://github.com/nilaoda/BBDown/releases/download/1.6.3/BBDown_1.6.3_20240814_linux-x64.zip
BBDOWN_BINARY_PATH=/opt/render/project/bin/BBDown
BBDOWN_USE_TV_API=true
BBDOWN_QUALITY_PRIORITY=720P 高清,480P 清晰
BBDOWN_ENCODING_PRIORITY=avc,hevc,av1

# Reserved for a future logged-in 1080P path. Leave empty for anonymous mode.
BBDOWN_COOKIE=

# --- Course video assets (Supabase Storage) ---
# Course chapter videos are downloaded by the worker and re-hosted in a PRIVATE
# Supabase Storage bucket, then served as short-lived signed URLs. Two
# credentials by design (core/storage.py): the service-role key SIGNS playback
# URLs; the S3 access keys authorize boto3 multipart UPLOAD/DELETE. Required
# only for the video pipeline; leave empty to boot without it.

# Supabase service-role key (Project Settings -> API). Signs private playback
# URLs. SECRET — never ship to the frontend, never commit.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Storage S3-compatible endpoint and credentials (Project Settings ->
# Storage -> S3 connection / access keys). The endpoint is shown there verbatim,
# e.g. https://your-project-ref.storage.supabase.co/storage/v1/s3
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=us-east-1
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=

# Private bucket that holds the re-hosted chapter videos (create it first).
SUPABASE_STORAGE_BUCKET=course-videos

# Sliding TTL in days: assets untouched this long are swept by the cleanup beat
# task (next access lazily re-downloads).
VIDEO_ASSET_TTL_DAYS=30

# Lifetime of a minted playback signed URL, in seconds (re-minted each fetch).
# Default 6h so it comfortably exceeds a full lecture's runtime.
VIDEO_SIGNED_URL_TTL_SECONDS=21600

# boto3 multipart parallelism: how many parts upload concurrently per file.
VIDEO_DOWNLOAD_CONCURRENCY=4

# --- PayPal payments (one-time credits, no auto-recharge) ---
# Channels: PayPal only on this branch. Stripe is stubbed out in core/config.py
# (stripe_ready is always False), so the frontend keeps the card button
# disabled and no stripe dependency is installed.

# sandbox (dev, no real money) | live (prod). Keep sandbox until the sandbox
# loop is verified end to end, then flip this together with VITE_PAYPAL_MODE in
# frontend/.env — live mode needs the live client id/secret pair, sandbox needs
# the sandbox pair, and mixing them makes PayPal reject the request.
PAYPAL_MODE=sandbox

# REST app credentials (PayPal Developer Dashboard -> Apps & Credentials).
# Generate one set per environment. SECRETS — never commit, never ship.
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=

# Webhook ID from that app's webhook config (Dashboard -> Webhooks). When set,
# /api/v1/webhooks/paypal verifies the PayPal-Transmission-Sig header and
# records anything unsigned as an error; when empty, verification is skipped
# (dev only).
#   Production URL: https://thelemma.ai/api/v1/webhooks/paypal   (POST)
#   Events:         PAYMENT.CAPTURE.COMPLETED      (required — grants credits)
#                   CHECKOUT.ORDER.APPROVED        (optional)
# PayPal only reaches publicly routable HTTPS, so local dev needs a tunnel and
# its own webhook entry (each webhook has its own id).
PAYPAL_WEBHOOK_ID=

# The frontend also needs the **publishable** client id, as
# VITE_PAYPAL_CLIENT_ID in frontend/.env. The secret stays here.

# --- Doc layer / Data Layer (Space Context) ---
# pages + blocks = "what the space holds" (Sources). The tables come from
# migration d5e6f7a8b9c0, which is written but NOT applied on this environment.
#
# Keep this false until the migration has run: with the flag off, /api/v1/pages
# answers 503 ("doc_api_disabled"), which a client can tell apart from a 500
# ("relation pages does not exist"). Flip to true once the tables exist.
DOC_FULL_API_ENABLED=false

# --- Question bank (学科网 XOP) ---
# Credentials from the XKW open platform (key = 16 digits, secret = 32 chars).
# SECRET — never commit, never ship to the frontend. Only the http provider
# needs them; the default fixture provider runs offline and never bills.
XKW_APP_ID=
XKW_SECRET=
XKW_BASE_URL=https://openapi.xkw.com
# 1 = documented Xop-Sign (sha1); 2 = Xop-Sign-V2 (hmac-sha256, only in the
# official Java client — verify with a real account before switching).
XKW_SIGN_VERSION=1
XKW_TIMEOUT_SECONDS=15

# fixture | http. fixture serves the rendering-doc samples (offline, free).
QBANK_XKW_PROVIDER=fixture
# Master switch for building question sets (each build may cost money).
QBANK_XKW_ENABLED=true
# Hard cap of XKW calls per question-set build (fetch pages + /medias).
QBANK_MAX_CALLS_PER_SET=2
# Hard cap of billable XKW calls per day, across all users.
QBANK_GLOBAL_DAILY_CALL_CAP=200
# Comma-separated profile UUIDs allowed to use the developer entry
# (POST /api/v1/qbank/admin/question-sets and the catalog reads).
QBANK_ADMIN_USER_IDS=
# Salt for the client_user_id sent to XKW (paper detail / content feedback).
QBANK_CLIENT_USER_SALT=
