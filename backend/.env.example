# Copy to backend/.env and fill in. backend/.env is gitignored — never commit it.
# Fields marked [required] have no default: the app refuses to boot without them.

# --- Core ---
# [required] Supabase project URL, e.g. https://<ref>.supabase.co
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated
# [required] Postgres DSN. Use the pooler host with the asyncpg driver:
# postgresql+asyncpg://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# --- AI providers ---
# [required] text/vision/video routing hits aihubmix; openrouter is the fallback.
AIHUBMIX_API_KEY=
# [required]
OPENROUTER_API_KEY=
AIHUBMIX_OPENAI_BASE_URL=https://aihubmix.com/v1
AIHUBMIX_GEMINI_BASE_URL=https://aihubmix.com/gemini
AI_DEFAULT_TIMEOUT_SECONDS=30
AI_VIDEO_ENGINE=native
# Per-use-case provider chains. Each channel must be registered in ai/config.py;
# an unknown platform/adapter pair fails startup validation. Keep this in sync
# with the code on the branch you are running.
AI_ROUTES_JSON=

# --- Course video pipeline ---
APIFY_API_TOKEN=
REDIS_URL=redis://localhost:6379/0
YTDLP_SOCKET_TIMEOUT_SECONDS=30
VIDEO_DOWNLOAD_ROUTES_JSON={"youtube": ["ytdlp"], "bilibili": ["bbdown", "ytdlp-fallback"], "default": ["ytdlp"]}
VIDEO_DOWNLOAD_TIMEOUT_SECONDS=1800
FFMPEG_PATH=ffmpeg
BBDOWN_BINARY_PATH=
BBDOWN_USE_TV_API=true
BBDOWN_QUALITY_PRIORITY=720P 高清,480P 清晰
BBDOWN_ENCODING_PRIORITY=avc,hevc,av1
BBDOWN_COOKIE=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=us-east-1
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_BUCKET=course-videos
VIDEO_ASSET_TTL_DAYS=30
VIDEO_SIGNED_URL_TTL_SECONDS=21600
VIDEO_DOWNLOAD_CONCURRENCY=4

# --- PayPal payments (one-time credits; no auto-recharge) ---
# sandbox (dev, no real money) | live. Keep sandbox until the sandbox loop is
# verified end to end, then flip both this and VITE_PAYPAL_MODE together.
PAYPAL_MODE=sandbox
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=
# From the PayPal app's webhook config. When set, /api/v1/webhooks/paypal
# verifies the transmission signature and rejects anything unsigned.
# Production webhook URL: https://thelemma.ai/api/v1/webhooks/paypal
# Events to subscribe: PAYMENT.CAPTURE.COMPLETED (required),
#                      CHECKOUT.ORDER.APPROVED (optional).
PAYPAL_WEBHOOK_ID=

# NOTE: the PayPal *client id* is also needed by the frontend, as
# VITE_PAYPAL_CLIENT_ID in frontend/.env. It is publishable and safe there;
# the secret stays here.
